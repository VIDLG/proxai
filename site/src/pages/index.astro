---
// Astro injects the configured `base` (see astro.config.mjs) as
// `import.meta.env.BASE_URL`, always with leading and trailing slashes.
// On a project Pages site this is "/proxai/", so locale roots become
// "/proxai/en/" and "/proxai/zh/". Falling back to "/" keeps this page
// correct if `base` is ever unset.
const base = import.meta.env.BASE_URL || "/";
const enRoot = `${base}en/`;
const zhRoot = `${base}zh/`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta http-equiv="refresh" content={`0; url=${enRoot}`} />
        <title>ProxAI Docs</title>
        <script is:inline define:vars={{ enRoot, zhRoot }}>
            const languages = navigator.languages || [
                navigator.language || "en",
            ];
            const target = languages.some((lang) =>
                lang.toLowerCase().startsWith("zh"),
            )
                ? zhRoot
                : enRoot;
            location.replace(target);
        </script>
    </head>
    <body>
        <main>
            <p>
                Redirecting to documentation…
                <a href={enRoot}>English</a>
                ·
                <a href={zhRoot}>中文</a>
            </p>
        </main>
    </body>
</html>
